[submodule "tests/plugins/DevTools"]
	path = tests/plugins/DevTools
	url = https://github.com/pmmp/DevTools.git
[submodule "build/php"]
	path = build/php
	url = https://github.com/pmmp/php-build-scripts.git
[submodule "examples/plugins/ExamplePlugin"]
	path = examples/plugins/ExamplePlugin
	url = https://github.com/pmmp/ExamplePlugin.git
[submodule "deps/pmmp-updater"]
	path = deps/pmmp-updater
	url = https://github.com/Riftal-Games/pmmp-updater.git
	update = none
